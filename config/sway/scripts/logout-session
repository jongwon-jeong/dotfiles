#!/usr/bin/env bash

readonly GRACEFUL_EXIT_ATTEMPTS=20
readonly TERM_EXIT_ATTEMPTS=20
readonly EXIT_POLL_SECONDS=0.1

_log_logout() {
  local -r priority="${1}"
  local journal_priority="6"
  local status_label="INFO"
  shift

  case "${priority}" in
    warning)
      journal_priority="4"
      status_label="WARN"
      ;;
    error)
      journal_priority="3"
      status_label="ERROR"
      ;;
  esac

  /usr/bin/timeout --kill-after=1s 1s /usr/bin/systemd-cat \
    --identifier=sway-logout \
    --priority="${journal_priority}" \
    --stderr-priority="${journal_priority}" \
    -- /usr/bin/printf '%s\n' "${*}" ||
    /usr/bin/printf '%s: %s\n' "${status_label}" "${*}" >&2
}

_is_current_user_sway() {
  local -r sway_pid="${1:-}"
  local command_path=""
  local process_name=""

  [[ "${sway_pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -d "/proc/${sway_pid}" && -O "/proc/${sway_pid}" ]] || return 1
  [[ -r "/proc/${sway_pid}/comm" && -r "/proc/${sway_pid}/cmdline" ]] || return 1

  IFS= read -r process_name <"/proc/${sway_pid}/comm" || return 1
  IFS= read -r -d '' command_path <"/proc/${sway_pid}/cmdline" || return 1
  [[ "${process_name}" == "sway" && "${command_path}" == "/usr/bin/sway" ]]
}

_current_sway_pid() {
  local -r runtime_dir="${XDG_RUNTIME_DIR:-}"
  local -r sway_socket="${SWAYSOCK:-}"
  local current_uid=""
  local socket_name=""
  local sway_pid=""

  [[ -n "${runtime_dir}" && "${runtime_dir}" == /* ]] || return 1
  [[ -d "${runtime_dir}" && -O "${runtime_dir}" ]] || return 1
  [[ "${sway_socket}" == "${runtime_dir}"/sway-ipc.*.sock ]] || return 1
  [[ -S "${sway_socket}" && -O "${sway_socket}" && ! -L "${sway_socket}" ]] || return 1

  current_uid="$(/usr/bin/id -u)" || return 1
  socket_name="${sway_socket##*/}"
  if [[ "${socket_name}" =~ ^sway-ipc\.${current_uid}\.([1-9][0-9]*)\.sock$ ]]; then
    sway_pid="${BASH_REMATCH[1]}"
  else
    return 1
  fi

  _is_current_user_sway "${sway_pid}" || return 1
  /usr/bin/printf '%s\n' "${sway_pid}"
}

_wait_for_sway_exit() {
  local -r sway_pid="${1}"
  local -r attempts="${2}"
  local attempt

  for ((attempt = 0; attempt < attempts; attempt++)); do
    if ! _is_current_user_sway "${sway_pid}"; then
      return 0
    fi
    /usr/bin/sleep "${EXIT_POLL_SECONDS}"
  done

  ! _is_current_user_sway "${sway_pid}"
}

_restore_session_services() {
  local -r sway_pid="${1}"

  _is_current_user_sway "${sway_pid}" || return 0

  if /usr/bin/timeout --kill-after=1s 5s \
    /usr/bin/systemctl --user start sway-session.target; then
    _log_logout warning "Restored Sway session services after logout recovery failed."
    return 0
  fi

  _log_logout error "Could not restore Sway session services after logout recovery failed."
  return 1
}

main() {
  local sway_pid=""
  local swaymsg_succeeded=false

  sway_pid="$(_current_sway_pid)" ||
    _log_logout warning "Could not verify the current Sway process; forced logout fallback is disabled."

  # Keep the desktop usable while requesting a normal exit. swaymsg can block
  # indefinitely when the compositor accepts the connection but never replies.
  if /usr/bin/timeout --kill-after=1s 2s /usr/bin/swaymsg exit >/dev/null 2>&1; then
    swaymsg_succeeded=true
  else
    _log_logout warning "The normal Sway exit request timed out or failed."
  fi

  if [[ -z "${sway_pid}" ]]; then
    if [[ "${swaymsg_succeeded}" == true ]]; then
      return 0
    fi
    _log_logout error "No verified Sway process is available for logout recovery."
    return 1
  fi

  if _wait_for_sway_exit "${sway_pid}" "${GRACEFUL_EXIT_ATTEMPTS}"; then
    return 0
  fi

  # The launcher handles normal session cleanup after Sway exits. Stop the
  # target here only when forced recovery is necessary, so a failed exit
  # request does not leave a running compositor without its desktop services.
  if ! /usr/bin/timeout --kill-after=1s 2s \
    /usr/bin/systemctl --user stop sway-session.target; then
    _log_logout warning "Could not stop all Sway session services before forced logout."
  fi

  if ! _is_current_user_sway "${sway_pid}"; then
    return 0
  fi

  _log_logout warning "Sway did not exit cleanly; sending SIGTERM to PID ${sway_pid}."
  if ! kill -TERM "${sway_pid}" 2>/dev/null; then
    _log_logout error "Could not send SIGTERM to verified Sway PID ${sway_pid}."
    _restore_session_services "${sway_pid}"
    return 1
  fi
  if _wait_for_sway_exit "${sway_pid}" "${TERM_EXIT_ATTEMPTS}"; then
    return 0
  fi

  if ! _is_current_user_sway "${sway_pid}"; then
    return 0
  fi

  _log_logout error "Sway ignored SIGTERM; sending SIGKILL to PID ${sway_pid}."
  if ! kill -KILL "${sway_pid}" 2>/dev/null; then
    _log_logout error "Could not send SIGKILL to verified Sway PID ${sway_pid}."
    _restore_session_services "${sway_pid}"
    return 1
  fi

  if ! _wait_for_sway_exit "${sway_pid}" "${TERM_EXIT_ATTEMPTS}"; then
    _log_logout error "Verified Sway PID ${sway_pid} remains after SIGKILL."
    _restore_session_services "${sway_pid}"
    return 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "${@}"
fi
