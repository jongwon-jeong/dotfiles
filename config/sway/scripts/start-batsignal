#!/usr/bin/env bash

battery_names=()
for power_supply_path in /sys/class/power_supply/*; do
  if [[ ! -r "${power_supply_path}/type" ]]; then
    continue
  fi

  if [[ "$(<"${power_supply_path}/type")" == "Battery" ]]; then
    # Peripheral batteries must never trigger a system power-off policy.
    if [[ -r "${power_supply_path}/scope" ]] &&
      [[ "$(<"${power_supply_path}/scope")" != "System" ]]; then
      continue
    fi

    battery_names+=("${power_supply_path##*/}")
  fi
done

# A desktop without batteries has no monitoring work to perform.
if ((${#battery_names[@]} == 0)); then
  exit 0
fi

battery_name_list="$(
  IFS=,
  printf "%s" "${battery_names[*]}"
)"
notification_script="${HOME}/.config/sway/scripts/notify-battery"
notification_command="\"${notification_script}\" \"%s\" \"%s\""
danger_script="${HOME}/.config/sway/scripts/handle-battery-danger"
danger_command="\"${danger_script}\""

exec /usr/bin/batsignal \
  -i \
  -w 20 \
  -c 10 \
  -d 5 \
  -W "Battery low" \
  -C "Battery critical" \
  -M "${notification_command}" \
  -D "${danger_command}" \
  -n "${battery_name_list}"
