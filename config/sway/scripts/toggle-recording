#!/usr/bin/env bash

_show_osd() {
  swayosd-client --custom-message "${1}" --custom-icon media-record-symbolic 2>/dev/null || true
}

_refresh_waybar() {
  # The recording module is event-driven so an idle bar does not poll forever.
  pkill -RTMIN+8 -x waybar 2>/dev/null || true
}

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
pid_file="${runtime_dir}/sway-wf-recorder.pid"

if [[ -r "${pid_file}" ]]; then
  existing_pid="$(<"${pid_file}")"
  if [[ "${existing_pid}" =~ ^[0-9]+$ ]] && kill -0 "${existing_pid}" 2>/dev/null; then
    existing_executable="$(readlink -f "/proc/${existing_pid}/exe" 2>/dev/null || true)"
    if [[ "${existing_executable}" == "/usr/bin/wf-recorder" ]]; then
      if kill -INT "${existing_pid}"; then
        _show_osd "Recording stopping"
        exit 0
      fi

      _show_osd "Recording could not stop"
      exit 1
    fi
  fi
fi

recording_dir="${HOME}/Videos/Recordings"
if ! mkdir -p "${recording_dir}"; then
  _show_osd "Recording directory unavailable"
  exit 1
fi

geometry="$(slurp)" || exit 0
recording_file="${recording_dir}/$(date +%Y%m%d-%H%M%S).mp4"

/usr/bin/wf-recorder -g "${geometry}" -f "${recording_file}" &
recorder_pid=$!

recorder_ready=false
for ((attempt = 0; attempt < 20; attempt++)); do
  recorder_executable="$(readlink -f "/proc/${recorder_pid}/exe" 2>/dev/null || true)"
  if [[ "${recorder_executable}" == "/usr/bin/wf-recorder" ]]; then
    recorder_ready=true
    break
  fi
  if ! kill -0 "${recorder_pid}" 2>/dev/null; then
    break
  fi
  sleep 0.05
done

if [[ "${recorder_ready}" != "true" ]]; then
  # A failed child may already be gone; stop it only if it survived the check.
  kill -INT "${recorder_pid}" 2>/dev/null || true
  _show_osd "Recording could not start"
  exit 1
fi

if ! printf '%s\n' "${recorder_pid}" >"${pid_file}"; then
  kill -INT "${recorder_pid}" 2>/dev/null || true
  _show_osd "Recording could not start"
  exit 1
fi

# These callbacks are invoked indirectly by the traps below.
# shellcheck disable=SC2329
cleanup() {
  if [[ -r "${pid_file}" ]] && [[ "$(<"${pid_file}")" == "${recorder_pid}" ]]; then
    rm -f "${pid_file}"
  fi
  _refresh_waybar
}
trap cleanup EXIT

# shellcheck disable=SC2329
terminate() {
  kill -INT "${recorder_pid}" 2>/dev/null || true
}
trap terminate INT TERM

_show_osd "Recording started"
_refresh_waybar
if wait "${recorder_pid}"; then
  _show_osd "Recording saved"
  exit 0
fi

_show_osd "Recording failed"
exit 1
